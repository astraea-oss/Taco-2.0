{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVE Intel Companion",
  "version": "0.1.0",
  "identifier": "com.astraea.eve-intel-companion",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EVE Intel Companion",
        "width": 1440,
        "height": 920
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
